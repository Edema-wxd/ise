# Copy to .env.local (gitignored). Most of this file is written for you:
#
#   neon env pull          # or `neon deploy`, which pulls after it applies
#
# pulls the Neon-managed variables for the linked branch. The two blocks at
# the bottom are ours — Neon never writes them, and `neon deploy --env
# .env.local` reads the Function block out of this file to upload it.

# --- Written by Neon ---------------------------------------------------------
# Pooled connection string. What the app queries.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Direct connection. Migrations and anything multi-statement.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"
# The branch these point at.
NEON_BRANCH="production"
# Managed Better Auth for this branch. Auth state branches with the database.
NEON_AUTH_BASE_URL="https://BRANCH.auth.REGION.aws.neon.tech/..."
NEON_AUTH_JWKS_URL="https://BRANCH.auth.REGION.aws.neon.tech/.../jwks"
# Public URL of the inquiries Function, declared in neon.ts.
NEON_FUNCTION_INQUIRIES_BASE_URL="https://BRANCH-inquiries.compute.CELL.REGION.aws.neon.tech/"

# --- Ours: app ---------------------------------------------------------------
# Signs the cached session cookie. 32 characters or more, or Neon Auth throws
# at startup. Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""

# --- Ours: uploaded to the Function by `neon deploy --env .env.local` --------
# Accounts allowed to read /studio, comma separated. An account that is not
# listed is signed in and still refused.
STUDIO_EMAILS="studio@example.com"
# Browser origins the Function will answer with CORS headers, comma separated.
# Add the deployed site's origin before launch.
STUDIO_ORIGINS="http://localhost:3000"
